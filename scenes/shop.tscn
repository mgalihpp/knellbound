[gd_scene format=3]

[ext_resource type="Script" path="res://ui/shop_screen.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://art/ui/title_bg.png" id="2_bg"]
[ext_resource type="Texture2D" path="res://art/ui/icon_coin.png" id="3_coin"]
[ext_resource type="Script" path="res://ui/level_pips.gd" id="4_pips"]

[node name="Shop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Ink" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.027, 0.02, 0.051, 1)

[node name="Background" type="TextureRect" parent="."]
modulate = Color(0.45, 0.42, 0.55, 1)
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("2_bg")
expand_mode = 1
stretch_mode = 6

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Head" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Titles" type="VBoxContainer" parent="Margin/VBox/Head"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Margin/VBox/Head/Titles"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "RELIQUARY"

[node name="Subtitle" type="Label" parent="Margin/VBox/Head/Titles"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Relics bought here bless every hunt to come."

[node name="Purse" type="PanelContainer" parent="Margin/VBox/Head"]
layout_mode = 2
