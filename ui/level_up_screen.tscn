[gd_scene format=3]

[ext_resource type="Script" path="res://ui/level_up_screen.gd" id="1_script"]

[node name="LevelUpScreen" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("1_script")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.01, 0.05, 0.6)

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
unique_name_in_owner = true
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "LEVEL UP!"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Level 2 - choose an upgrade"
horizontal_alignment = 1

[node name="Cards" type="VBoxContainer" parent="Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="Actions" type="HBoxContainer" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="RerollButton" type="Button" parent="Center/Panel/VBox/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(170, 44)
layout_mode = 2
text = "Reroll 2"

[node name="SkipButton" type="Button" parent="Center/Panel/VBox/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(170, 44)
layout_mode = 2
text = "Skip 2"

[node name="BanishButton" type="Button" parent="Center/Panel/VBox/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(170, 44)
layout_mode = 2
toggle_mode = true
text = "Banish 2"

[node name="Hint" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_type_variation = &"SmallLabel"
theme_override_colors/font_color = Color(0.608, 0.565, 0.69, 1)
text = "[1-4] pick  ·  arrows / d-pad + Enter / (A)  ·  mouse  ·  Esc / (B) leaves banish mode"
horizontal_alignment = 1
